# Nonsecret configuration only. Store the real file outside Git.
BACKEND_IMAGE=proppulse-oracle-backend:arm64
POSTGRES_IMAGE=proppulse-oracle-postgres:arm64
GATEWAY_IMAGE=nginx:stable-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
SECRETS_DIR=/srv/proppulse/secrets
NGINX_CONFIG_DIR=/srv/proppulse/gateway
PG_DATABASE=proppulse
CORS_ORIGINS=["https://app.example.com"]
# Loopback by default. Public binding needs explicit firewall/TLS/zone approval.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=443
API_SUBNET=10.78.0.0/24
GATEWAY_IP=10.78.0.2
BACKEND_IP=10.78.0.3
