# Local backend (Compose overrides host to db). Development credentials only.
DATABASE_URL=postgresql://proppulse:proppulse@localhost:5432/proppulse
# Optional: Redis is not used by application caching.
REDIS_URL=redis://localhost:6379/0
# Replace with a private random secret; this placeholder is rejected in production.
JWT_SECRET=replace-with-a-private-random-secret
JWT_ALGORITHM=HS256
# Absolute session lifetime; production/staging rejects values above 1440 minutes.
JWT_EXPIRE_MINUTES=120
# Host-only HttpOnly cookies; Secure is mandatory in production/staging.
# Prefer same-site HTTPS frontend/API domains with lax. For separate sites choose
# none (requires HTTPS); CSRF proof and exact trusted Origin are still required.
AUTH_COOKIE_SAMESITE=lax
# Production requires an actual trusted gateway limiting auth and research APIs
# across all workers/instances. Enable only after configuring/verifying that edge.
GATEWAY_RATE_LIMIT_ENABLED=false
# Current mutation APIs accept JSON, no production upload route exists.
API_MAX_BODY_BYTES=1048576
ENVIRONMENT=development
# Exact JSON origins. Production requires explicit HTTPS origins and a random JWT secret.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Frontend build setting: also set in frontend/.env.local; never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional legacy ML integration; not required for research/demo.
BALLDONTLIE_API_KEY=
# Optional provider credential; leave empty for retained/offline demo.
THE_ODDS_API_KEY=
# Enabling this can start provider requests and DB writes. Requires explicit scope.
LIVE_REFRESH_ENABLED=false
ODDS_REFRESH_SECONDS=900
HISTORY_REFRESH_SECONDS=21600
ODDS_EVENT_HORIZON_HOURS=48
ODDS_EVENT_FETCH_LIMIT=0
ODDS_MIN_REMAINING_CREDITS=50

# Hard per-run caps count HTTP attempts (including retries) and reserve credit costs.
ODDS_MAX_REQUESTS_PER_RUN=100
ODDS_MAX_CREDITS_PER_RUN=500
