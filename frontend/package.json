{
  "name": "proppulse-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config playwright.integration.config.cjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 3199"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "next": "15.5.29",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "recharts": "^2.15.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.14.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
